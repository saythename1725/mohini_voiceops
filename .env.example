# Copy this file to .env and enter your own Gnani API key for Step 4 voice mode.
# Do not commit .env or place a real key in source code.
GNANI_API_KEY=

# Absolute path to the separately supplied dataset directory containing kb/, data/, and tools/.
# Keep the dataset outside the submission ZIP.
VOICEOPS_DATASET_ROOT=

# Gemini embedding settings for KB retrieval.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

# Local Ollama model used for query rewriting and answer generation.
OLLAMA_MODEL=qwen2.5:3b
